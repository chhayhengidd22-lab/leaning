rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Global settings: readable by all, writable only by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: readable by all, writable only by admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subjects and lessons: readable by all, writable only by admin
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // User profiles: users can read their own or admin can read/write
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      match /progress/{subjectId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
