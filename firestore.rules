rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidSettings(data) {
      return data is map && data.siteName is string && data.siteName.size() > 0;
    }

    function isValidCategory(data) {
      return data is map && data.id is string && data.name is string;
    }

    function isValidSubject(data) {
      return data is map && data.id is string && data.name is string;
    }

    function isValidLesson(data) {
      return data is map && data.id is string && data.title is string;
    }

    function isValidMaterial(data) {
      return data is map && data.id is string && data.title is string;
    }

    // Global settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidSettings(request.resource.data);
      allow delete: if false;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidCategory(request.resource.data);
      allow delete: if true;
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update: if isValidSubject(request.resource.data);
      allow delete: if true;

      match /lessons/{lessonId} {
        allow read: if true;
        allow create, update: if isValidLesson(request.resource.data);
        allow delete: if true;
      }
    }

    // Top-level Lessons
    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update: if isValidLesson(request.resource.data);
      allow delete: if true;
    }

    // Materials
    match /materials/{materialId} {
      allow read: if true;
      allow create, update: if isValidMaterial(request.resource.data);
      allow delete: if true;
    }

    // User profiles, progress, and bookmarks
    match /users/{userId} {
      allow read, write: if true;

      match /progress/{subjectId} {
        allow read, write: if true;
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if true;
      }
    }

    // Connection & sync state
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
